# Master key for encrypting user API keys in SQLite (64 hex characters / 32 bytes)
# Generate with: npm run genkey
MASTER_KEY=

# Storage paths
DATA_DIR=./data
DB_PATH=./data/bot.db
AUTH_DIR=./data/auth

# Conversation & session behaviour
SESSION_TIMEOUT_MINUTES=30
MAX_HISTORY_TURNS=20

# File handling
MAX_FILE_SIZE_MB=15
MAX_FILES_PER_BURST=5
MEDIA_DEBOUNCE_MS=2000
MEDIA_CAPTION_WAIT_MS=120000

# Abuse protection
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
MAX_CONCURRENT_GEMINI_CALLS=3

# Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# WhatsApp native disappearing messages (cosmetic only)
ENABLE_DISAPPEARING_MESSAGES=false
DISAPPEARING_SECONDS=86400
